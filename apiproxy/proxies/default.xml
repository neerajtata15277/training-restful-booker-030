<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
  <Description/>
  <FaultRules/>
  <PreFlow name="PreFlow">
    <Request/>
    <Response/>
  </PreFlow>
  <PostFlow name="PostFlow">
    <Request/>
    <Response/>
  </PostFlow>
  <Flows>
    <Flow name="getBookingIds">
      <Description>GetBookingIds</Description>
      <Request/>
      <Response/>
      <Condition>(proxy.pathsuffix MatchesPath "/booking") and (request.verb = "GET")</Condition>
    </Flow>
    <Flow name="createBooking">
      <Description>CreateBooking</Description>
      <Request/>
      <Response/>
      <Condition>(proxy.pathsuffix MatchesPath "/booking") and (request.verb = "POST")</Condition>
    </Flow>
    <Flow name="getBooking">
      <Description>GetBooking</Description>
      <Request/>
      <Response/>
      <Condition>(proxy.pathsuffix MatchesPath "/booking/{id}") and (request.verb = "GET")</Condition>
    </Flow>
    <Flow name="updateBooking">
      <Description>UpdateBooking</Description>
      <Request/>
      <Response/>
      <Condition>(proxy.pathsuffix MatchesPath "/booking/{id}") and (request.verb = "PUT")</Condition>
    </Flow>
    <Flow name="deleteBooking">
      <Description>DeleteBooking</Description>
      <Request/>
      <Response/>
      <Condition>(proxy.pathsuffix MatchesPath "/booking/{id}") and (request.verb = "DELETE")</Condition>
    </Flow>
  </Flows>
  <HTTPProxyConnection>
    <BasePath>/training-restful-booker-030</BasePath>
    <Properties/>
  </HTTPProxyConnection>
  <RouteRule name="default">
    <TargetEndpoint>default</TargetEndpoint>
  </RouteRule>
</ProxyEndpoint>
